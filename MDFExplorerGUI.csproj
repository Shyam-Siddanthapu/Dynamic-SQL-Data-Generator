<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>WinExe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SQLTestDataScriptGenerator</AssemblyName>
    <RootNamespace>SQLTestDataScriptGenerator</RootNamespace>
    <PublisherName>Zelis</PublisherName>
    <ProductName>SQL Test Data Script Generator</ProductName>
    <ApplicationTitle>SQL Test Data Script Generator</ApplicationTitle>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.0" />
    <PackageReference Include="Microsoft.SqlServer.TransactSql.ScriptDom" Version="170.128.0" />
  </ItemGroup>
</Project>